{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "appops-overview"
  },
  "spec": {
    "uid": "appops-overview",
    "title": "Application Operations",
    "description": "Traffic panels exclude health checks. Rates and estimated p95 response times use five-minute windows.",
    "schemaVersion": 41,
    "version": 1,
    "editable": false,
    "timezone": "browser",
    "tags": [
      "operations"
    ],
    "refresh": "15s",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "environment",
          "label": "Environment",
          "type": "custom",
          "query": "staging,production",
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": [
            {
              "text": "All",
              "value": "$__all",
              "selected": true
            },
            {
              "text": "staging",
              "value": "staging",
              "selected": false
            },
            {
              "text": "production",
              "value": "production",
              "selected": false
            }
          ]
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "API scrape status",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 4
        },
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red"
                  },
                  "1": {
                    "text": "UP",
                    "color": "green"
                  }
                }
              }
            ]
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "up{job=\"application-api\",environment=~\"${environment:regex}\"}",
            "legendFormat": "{{environment}}",
            "range": false,
            "instant": true
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "horizontal",
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "none"
        },
        "description": "Whether Prometheus can scrape the API. Database readiness is checked separately by /health/ready."
      },
      {
        "id": 2,
        "title": "Request rate",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "noValue": "No data",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 8,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum by (environment) (rate(app_http_requests_total{job=\"application-api\",environment=~\"${environment:regex}\",route!~\"/health/.*|/metrics\"}[5m]))",
            "legendFormat": "{{environment}}",
            "range": true
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 3,
        "title": "Server errors (%)",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "noValue": "No data",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 8,
              "spanNulls": false
            },
            "max": 100
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "100 * ((sum by (environment) (rate(app_http_requests_total{job=\"application-api\",environment=~\"${environment:regex}\",route!~\"/health/.*|/metrics\",status=~\"5..\"}[5m])) or on (environment) (0 * (sum by (environment) (rate(app_http_requests_total{job=\"application-api\",environment=~\"${environment:regex}\",route!~\"/health/.*|/metrics\"}[5m]))))) / (sum by (environment) (rate(app_http_requests_total{job=\"application-api\",environment=~\"${environment:regex}\",route!~\"/health/.*|/metrics\"}[5m]))))",
            "legendFormat": "{{environment}}",
            "range": true
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "description": "HTTP 5xx responses as a percentage of application requests over five minutes. No traffic produces no percentage."
      },
      {
        "id": 4,
        "title": "Response time (p95)",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "noValue": "No data",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 8,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "histogram_quantile(0.95, sum by (environment, le) (rate(app_http_request_duration_seconds_bucket{job=\"application-api\",environment=~\"${environment:regex}\",route!~\"/health/.*|/metrics\"}[5m])))",
            "legendFormat": "{{environment}}",
            "range": true
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 5,
        "title": "Requests by route",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "noValue": "No data",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 8,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum by (environment, route) (rate(app_http_requests_total{job=\"application-api\",environment=~\"${environment:regex}\",route!~\"/health/.*|/metrics\"}[5m]))",
            "legendFormat": "{{environment}} {{route}}",
            "range": true
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 6,
        "title": "Requests by status",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 24,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "noValue": "No data",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 8,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum by (environment, status) (rate(app_http_requests_total{job=\"application-api\",environment=~\"${environment:regex}\",route!~\"/health/.*|/metrics\"}[5m]))",
            "legendFormat": "{{environment}} {{status}}",
            "range": true
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      }
    ]
  }
}
